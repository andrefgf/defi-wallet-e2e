{
  "name": "defi-wallet-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests that drive a real MetaMask against live Aave v3 on Base Sepolia — wallet connection, the full lending lifecycle, and failure modes. Playwright + TypeScript.",
  "type": "module",
  "author": "André Guerra <https://www.linkedin.com/in/andrefgfrancisco>",
  "license": "MIT",
  "homepage": "https://github.com/andrefgf/defi-wallet-e2e#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrefgf/defi-wallet-e2e.git"
  },
  "bugs": {
    "url": "https://github.com/andrefgf/defi-wallet-e2e/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "wallet:address": "tsx scripts/wallet-address.ts",
    "wallet:balance": "tsx scripts/check-balance.ts",
    "mint:tokens": "tsx scripts/mint-test-tokens.ts",
    "fetch:metamask": "bash scripts/fetch-metamask.sh",
    "build:cache": "pnpm run fetch:metamask && tsx scripts/build-cache.ts",
    "build:cache:headless": "pnpm run fetch:metamask && cross-env HEADLESS=true tsx scripts/build-cache.ts",
    "test": "cross-env HEADLESS=true playwright test",
    "test:smoke": "cross-env HEADLESS=true playwright test tests/connection.spec.ts",
    "test:demo": "cross-env HEADLESS=true RECORD_VIDEO=1 playwright test",
    "preflight": "tsx scripts/check-balance.ts --check",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "e2e",
    "e2e-testing",
    "end-to-end-testing",
    "playwright",
    "synpress",
    "metamask",
    "wallet",
    "web3",
    "defi",
    "aave",
    "ethereum",
    "base-sepolia",
    "dapp",
    "qa",
    "qa-automation",
    "test-automation",
    "typescript"
  ],
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@synthetixio/synpress": "^4.1.2",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "viem": "^2.55.1"
  },
  "pnpm": {
    "overrides": {
      "@playwright/test": "1.48.2",
      "playwright": "1.48.2",
      "playwright-core": "1.48.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
