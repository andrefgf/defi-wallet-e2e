# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Use a DEDICATED, THROWAWAY wallet only — see "Security notes" in README.md.
# ---------------------------------------------------------------------------

# 12/24-word seed phrase of a THROWAWAY test wallet. Must never hold real funds.
SEED_PHRASE="test test test test test test test test test test test junk"

# Password used for the in-test MetaMask instance. Any value; must stay stable
# between building the wallet cache and running the tests.
WALLET_PASSWORD="Tester@1234"

# The dApp under test.
#
# Aave's ONLY remaining testnet market is Base Sepolia (proto_base_sepolia_v3) —
# Ethereum Sepolia has been retired from the app, even under "legacy markets".
# So the test wallet needs BASE Sepolia ETH for gas, not Ethereum Sepolia ETH.
#
# Note: `?testnet=true` does NOT enable testnet mode — that flag lives in
# localStorage, and the test fixture sets it. Without it the app serves the
# MAINNET market, which has no faucet.
DAPP_URL="https://app.aave.com/?marketName=proto_base_sepolia_v3"

# Base Sepolia RPC (only needed for optional on-chain assertions).
BASE_SEPOLIA_RPC_URL="https://base-sepolia-rpc.publicnode.com"

# Set to "true" to run browsers headless (CI does this automatically).
# HEADLESS=true

# --- Rabby (matrix wallet #2) -------------------------------------------------
# A SEPARATE burner from SEED_PHRASE, on purpose: matrix work must never be able
# to touch the funded wallet the lending suite uses. 12-word seed; 24 words are
# not yet supported (the word-count selector needs switching first).
RABBY_SEED_PHRASE=
RABBY_WALLET_PASSWORD=

# --- Phantom (matrix wallet #3) -----------------------------------------------
# Again a SEPARATE burner. Same rule: never a seed that has held value.
#
# Phantom differs from the other two in one way that matters for the matrix: it
# ships through the Chrome Web Store only and publishes no downloadable build,
# so it CANNOT be version-pinned the way METAMASK_VERSION and RABBY_VERSION are.
# `pnpm run fetch:phantom` pulls the current build from Google's CRX endpoint and
# prints the version it resolved. That version MUST be written into the
# `wallet_version` column for every Phantom cell — it is the only thing making
# those cells reproducible after the fact.
PHANTOM_SEED_PHRASE=
PHANTOM_WALLET_PASSWORD=
