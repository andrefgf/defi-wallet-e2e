# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Use a DEDICATED, THROWAWAY wallet only — see "Security notes" in README.md.
# ---------------------------------------------------------------------------

# 12/24-word seed phrase of a THROWAWAY test wallet. Must never hold real funds.
SEED_PHRASE="test test test test test test test test test test test junk"

# Password used for the in-test MetaMask instance. Any value; must stay stable
# between building the wallet cache and running the tests.
WALLET_PASSWORD="Tester@1234"

# The dApp under test.
#
# Aave's ONLY remaining testnet market is Base Sepolia (proto_base_sepolia_v3) —
# Ethereum Sepolia has been retired from the app, even under "legacy markets".
# So the test wallet needs BASE Sepolia ETH for gas, not Ethereum Sepolia ETH.
#
# Note: `?testnet=true` does NOT enable testnet mode — that flag lives in
# localStorage, and the test fixture sets it. Without it the app serves the
# MAINNET market, which has no faucet.
DAPP_URL="https://app.aave.com/?marketName=proto_base_sepolia_v3"

# Base Sepolia RPC (only needed for optional on-chain assertions).
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# Set to "true" to run browsers headless (CI does this automatically).
# HEADLESS=true
